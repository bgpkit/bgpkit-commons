# Copy to a private file (for example /etc/bgpkit/pg-inserter.env, mode 600)
# and fill in; never commit or build a filled copy into an image.
#
#   docker run --rm --env-file pg-inserter.env bgpkit/pg-inserter asndata
#
# PostgreSQL connection string for the target database (required).
DATABASE_URL=postgresql://pg_inserter@db.example:5432/bgpkit_broker

# PeeringDB API key; required for the full peeringdb mirror without rate limits.
PEERINGDB_API_KEY=
